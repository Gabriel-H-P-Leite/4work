#!/bin/bash

# Escolhe uma janela aberta pelo título e imprime o endereço dela (vazio se cancelar)
escolher_janela() {
	local clientes titulo
	clientes=$(hyprctl clients -j)
	titulo=$(echo "$clientes" | jq -r '.[] | select(.title != "") | .title' | qsmenu "$1") || return 1
	# comparação exata: "contains" pegava a janela errada quando um título contém outro
	echo "$clientes" | jq -r --arg t "$titulo" '[.[] | select(.title == $t)][0].address // empty'
}

case "${1:-}" in
	1) #atualizar
		# fora de um terminal (atalho do Hyprland): abre o kitty rodando esta mesma opção
		if [ ! -t 1 ]; then
			exec kitty menus 1
		fi

		BLU='\033[0;34m'
		YEL='\033[0;33m'
		NC='\033[0m'
		flags="--noconfirm --needed"
		echo -e "${BLU}███╗░░░███╗░█████╗░███╗░░██╗██╗░░░██╗████████╗███████╗███╗░░██╗░█████╗░░█████╗░░█████╗░\n████╗░████║██╔══██╗████╗░██║██║░░░██║╚══██╔══╝██╔════╝████╗░██║██╔══██╗██╔══██╗██╔══██╗\n██╔████╔██║███████║██╔██╗██║██║░░░██║░░░██║░░░█████╗░░██╔██╗██║██║░░╚═╝███████║██║░░██║\n██║╚██╔╝██║██╔══██║██║╚████║██║░░░██║░░░██║░░░██╔══╝░░██║╚████║██║░░██╗██╔══██║██║░░██║\n██║░╚═╝░██║██║░░██║██║░╚███║╚██████╔╝░░░██║░░░███████╗██║░╚███║╚█████╔╝██║░░██║╚█████╔╝\n╚═╝░░░░░╚═╝╚═╝░░╚═╝╚═╝░░╚══╝░╚═════╝░░░░╚═╝░░░╚══════╝╚═╝░░╚══╝░╚════╝░╚═╝░░╚═╝░╚════╝░╗░${NC}"

		echo -e "${YEL}Atualizando sistema${NC}"
		paru -Syu $flags

		echo -e "${YEL}Removendo pacotes órfãos${NC}"
		orfaos=$(paru -Qdtq || true)
		if [ -n "$orfaos" ]; then
			paru -Rns $orfaos
		else
			echo "Nenhum pacote órfão"
		fi

		echo -e "${YEL}Limpando cache${NC}"
		# o paru -Scc já limpa o cache do pacman junto com o dos pacotes do AUR
		paru -Scc
		echo -e "${YEL}Cache restante:${NC}"
		du -sh ~/.cache/
		sudo du -sh /var/cache/

		echo -e "${YEL}Apagando logs com mais de 7 dias${NC}"
		sudo journalctl --vacuum-time=7d

		read -rp $'\nPronto. Enter pra fechar...'
	;;
	2) #baixar
		tipo=${2:-$(printf "audio\nvideo\n" | qsmenu "Tipo de download")} || exit 0
		url=${3:-$(cliphist list | qsmenu "Link pra baixar" | cliphist decode)} || exit 0
		[ -n "$tipo" ] && [ -n "$url" ] || exit 0

		case "$tipo" in
			audio)
				pasta=$(xdg-user-dir MUSIC)
				formato=(-f bestaudio --extract-audio --audio-format mp3)
			;;
			video)
				pasta=$(xdg-user-dir VIDEOS)
				formato=(-f 'bestvideo+bestaudio/best' --merge-output-format mp4)
			;;
			*) exit 1 ;;
		esac

		notify-send -e "Baixando $tipo" "$url"
		if yt-dlp "${formato[@]}" --embed-metadata -P "$pasta" "$url"; then
			notify-send -e "Download concluído" "Salvo em $pasta"
		else
			notify-send -u critical "Falha no download" "$url"
		fi
	;;
	3) #alt tab
		id=$(escolher_janela "Ir pra janela") || exit 0
		[ -n "$id" ] || exit 0
		hyprctl dispatch "hl.dsp.focus({ window = \"address:$id\" })" > /dev/null
	;;
	4) #fixar janela
		id=$(escolher_janela "Fixar janela") || exit 0
		[ -n "$id" ] || exit 0
		# pin só funciona em janela flutuante
		hyprctl dispatch "hl.dsp.window.float({ action = \"set\", window = \"address:$id\" })" > /dev/null
		hyprctl dispatch "hl.dsp.window.pin({ window = \"address:$id\" })" > /dev/null
		notify-send -e -t 2000 "Janela fixada"
	;;
	*)
		menus $(printf "1: atualizar o sistema\n2: baixar áudio/vídeo\n3: ir pra uma janela\n4: fixar uma janela" |  qsmenu "Opções" | cut -d ":" -f 1) 
		exit 1
	;;
esac
